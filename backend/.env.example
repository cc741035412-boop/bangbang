DEEPSEEK_API_KEY=
BANGBANG_AI_MODE=mock

# 本地开发可显式设为 mock；生产环境禁止使用 mock。
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456
BANGBANG_ENV=development
BANGBANG_DB_PATH=bangbang.db
BANGBANG_UPLOAD_DIR=uploads
BANGBANG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---- 工作流 A 视觉白描（火山方舟 豆包 Seed-2.0-mini）----
# mock = 演示白描（默认）；doubao = 接豆包视觉（需下面 Key 与接入点）。
BANGBANG_VISION_MODE=mock
BANGBANG_ARK_API_KEY=
# 火山方舟「在线推理-创建推理接入点」后得到的 ep- 端点 ID（如 ep-20260829115439-ltlk6）
BANGBANG_DOUBAO_VISION_MODEL=

# ---- 工作流 A 语音转写 ASR（复用同一把 ark Key 与多模态接入点）----
# mock = 不转写（白描不引用对话，默认）；doubao = 接豆包多模态 ASR。
# 音频以 base64 直接传给模型，无需公网 URL / 对象存储。
BANGBANG_ASR_MODE=mock
# 默认复用 BANGBANG_DOUBAO_VISION_MODEL（同一接入点已验证支持音频）；有专门 ASR 接入点可单独指定。
BANGBANG_ASR_MODEL=
# 可选：超时秒数，默认 120。
BANGBANG_ASR_TIMEOUT_SECONDS=
# 短视频/无声视频降级：低于该秒数的视频不触发云端 ASR（省一次网络往返），默认 15。
# 无声视频另按音量阈值判断跳过；纯演示可保持 BANGBANG_ASR_MODE=mock。
BANGBANG_ASR_MIN_DURATION_SEC=15
